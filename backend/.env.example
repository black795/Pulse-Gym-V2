# Copia este archivo como ".env" (Windows: copy .env.example .env) y ajusta lo que necesites.
# El archivo ".env" NO se sube a GitHub.

ENTORNO=desarrollo
# SQLite sirve para empezar sin instalar nada. Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg://pulse:pulse@localhost:5432/pulse_gym
DATABASE_URL=sqlite:///./pulse_gym.db

# En producción debe ser una clave larga y aleatoria (32+ caracteres).
SECRET_KEY=cambia-esta-clave-en-produccion-ya

# Dónde corre la app web (para permitirle hablar con la API y armar los enlaces de los correos).
CORS_ORIGINS=http://localhost:5173
URL_APP=http://localhost:5173

# Cuenta de prueba (solo desarrollo)
SEED_DEMO=true

# Correo: "consola" imprime los correos en la terminal (ideal para desarrollar).
# Para enviar de verdad usa "smtp" y completa los datos.
CORREO_MODO=consola
CORREO_REMITENTE=Pulse Gym <no-responder@pulsegym.app>
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=

# --- Sprint 2: fotos de máquinas e IA ---
# Las fotos se guardan aquí (carpeta privada, NO se sube a GitHub). Solo se ven con enlaces que vencen en 1 hora.
FOTOS_DIR=./uploads/fotos

# IA con visión para reconocer máquinas.
#   auto     = usa Gemini si hay GEMINI_API_KEY; si no, una IA "simulada" para probar el flujo sin internet.
#   gemini   = Google Gemini (capa gratuita). Crea tu clave gratis en https://aistudio.google.com/apikey
#   replicate = solo Replicate (ver REPLICATE_API_TOKEN abajo)
#   simulada = nunca llama a internet; sugiere máquinas al azar (pero del catálogo real).
# OJO: en la capa gratuita Google puede usar las fotos para mejorar sus productos. Úsala para probar, no con usuarios reales.
IA_PROVEEDOR=auto
GEMINI_API_KEY=
# "gemini-flash-lite-latest" es rápido (~2-3 s) y estable en la capa gratuita.
GEMINI_MODELO=gemini-flash-lite-latest
IA_TIMEOUT_SEG=15
# Respaldo si Gemini falla o tarda: Gemini 2.5 Flash en Replicate (cobra por tokens; acepta texto e imágenes).
# Crea el token en https://replicate.com/account/api-tokens. Con menos de USD 5 de saldo, Replicate solo permite
# 6 pedidos por minuto y de a uno: el plan (5 pedidos a la vez) casi no lo podrá usar hasta cargar saldo.
# IA_PROVEEDOR=replicate usa solo Replicate.
REPLICATE_API_TOKEN=
REPLICATE_MODELO=google/gemini-2.5-flash
# PG-09: desde esta confianza el usuario solo confirma (a calibrar con pruebas reales).
UMBRAL_CONFIANZA_ALTA=0.85

# --- Sprint 3: plan semanal y límites de la IA (PG-23, PG-26, PG-28, PG-49) ---
# El plan se arma en menos de 20 s: si la IA no termina antes de esto, se usa la versión de solo reglas.
PLAN_TIEMPO_MAX_SEG=18
PLAN_IA_REINTENTOS=2
PLAN_REGENERACIONES_DIA=3
ADAPTACION_TIEMPO_MAX_SEG=8
# Si un pedido a la IA tarda más que esto, se lanza una copia y se usa la que llegue primero (0 = desactivado).
IA_DUPLICAR_TRAS_SEG=6
# Límites por usuario al día.
IA_LIMITE_FOTOS_DIA=50
IA_LIMITE_BUSQUEDAS_WEB_DIA=3
IA_LIMITE_PLANES_DIA=5
IA_LIMITE_ADAPTACIONES_DIA=30
# Costo estimado (USD por millón de tokens) y tope diario; si se supera, se avisa por correo a IA_ALERTA_EMAIL.
IA_PRECIO_ENTRADA_USD_MILLON=0.10
IA_PRECIO_SALIDA_USD_MILLON=0.40
REPLICATE_PRECIO_ENTRADA_USD_MILLON=0.30
REPLICATE_PRECIO_SALIDA_USD_MILLON=2.50
IA_COSTO_TOPE_DIARIO_USD=5
IA_ALERTA_EMAIL=
